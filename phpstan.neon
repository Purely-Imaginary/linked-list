parameters:
    level: 10
    phpVersion: 80500
    paths:
        - src
        - tests
    parallel:
        maximumNumberOfProcesses: 1
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # Test fixture uses mutable public arrays for recording — intentional
        -
            identifier: shipmonk.publicPropertyNotReadonly
            paths:
                - tests/
        # Node::$next is public for SortedLinkedList access but @internal protects from outside
        -
            identifier: shipmonk.publicPropertyNotReadonly
            paths:
                - src/Node.php

includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/shipmonk/phpstan-rules/rules.neon
    - vendor/shipmonk/dead-code-detector/rules.neon
